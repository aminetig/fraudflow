# Modèle du fichier .env : copie-le en .env, puis change les valeurs.
# Le fichier .env contient les secrets : il n'est jamais versionné dans Git.
# Lettres et chiffres uniquement.

# Identifiants du stockage S3 local (MinIO), 8 caractères minimum
MINIO_ROOT_USER=fraudflow
MINIO_ROOT_PASSWORD=changeMeMinio123

# Entrepôt PostgreSQL (bases warehouse et airflow)
POSTGRES_USER=fraudflow
POSTGRES_PASSWORD=changeMePostgres123

# Base des alertes MongoDB
MONGO_USER=fraudflow
MONGO_PASSWORD=changeMeMongo123

# Mot de passe du compte admin de Grafana
GRAFANA_ADMIN_PASSWORD=changeMeGrafana123

# Sel secret de la pseudonymisation des numéros de carte, 16 caractères minimum
CARD_HASH_SALT=changeMeWithALongRandomSalt

# Débit du générateur, en transactions par seconde
GENERATOR_RATE=10
